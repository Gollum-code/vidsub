{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vidsub",
  "version": "0.1.0",
  "identifier": "com.vidsub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vidsub",
        "width": 1120,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Local video subtitle tool",
    "longDescription": "vidsub - local, private, one-click video subtitle generation powered by whisper.cpp",
    "copyright": "vidsub",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/bin/*"]
  }
}